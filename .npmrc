# Используем Nexus как основной репозиторий (он должен проксировать публичные пакеты)
registry=https://nexus.apps.devops.bcc.kz/repository/npm-group/

# Если Nexus не проксирует публичные пакеты, можно использовать fallback
# Но сначала попробуем с текущей настройкой

# Для приватных пакетов с scope @bcc (если используется)
# @bcc:registry=https://nexus.apps.devops.bcc.kz/repository/npm-group/
